<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Indication on the keyguard that is shown when the device is charging with a super fast (vendor turbo) charger. [CHAR LIMIT=50] -->
    <string name="keyguard_plugged_in_charging_super_fast"><xliff:g id="percentage">%s</xliff:g> • Charging super fast</string>
    <!-- Indication on the keyguard while charging super fast, with the estimated time to full. [CHAR LIMIT=80] -->
    <string name="keyguard_indication_charging_time_super_fast"><xliff:g id="percentage">%2$s</xliff:g> • Charging super fast • Full in <xliff:g id="charging_time_left" example="4 hr, 2 min">%1$s</xliff:g></string>
</resources>
